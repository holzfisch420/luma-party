{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/server", "src/desktop", "src/shared", "src/games/**/game-config.ts", "src/games/**/game-engine.ts", "src/games/**/words/*.ts", "src/games/**/types.ts", "src/games/**/logic/*.ts", "src/games/game-catalog.ts"]
}
