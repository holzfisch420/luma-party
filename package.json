{
  "name": "luma-party",
  "version": "1.0.0",
  "private": true,
  "description": "Luma Party – Multi-Game-Party-Launcher (Hauptbildschirm + Smartphones als Controller)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "desktop": "node scripts/build-desktop.mjs",
    "desktop:windows": "node scripts/build-desktop.mjs windows"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "bun": "^1.4.4",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
